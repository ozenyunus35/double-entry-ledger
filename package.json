{
  "name": "double-entry-ledger",
  "version": "1.0.0",
  "private": true,
  "description": "Folio: double-entry bookkeeping in the browser. Journal, ledger, trial balance, statements, invoices and bills, VAT, multi-currency revaluation and year-end close, in the international chart or the Turkish uniform chart of accounts.",
